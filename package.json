{
  "name": "job-tracker",
  "version": "2.14.1",
  "description": "Suivi de candidatures (jobs, alternance, stages) sur une seule page + API pour agents IA (REST auto-documentée et MCP)",
  "keywords": [
    "candidatures",
    "alternance",
    "emploi",
    "suivi",
    "pdf",
    "mcp",
    "api"
  ],
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "mcp": "node mcp-server.js",
    "migrate:json": "node scripts/migrate-json.js",
    "test": "node --test test/*.test.js"
  },
  "bin": {
    "job-tracker-mcp": "./mcp-server.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "chart.js": "^4.5.1",
    "tabulator-tables": "^6.5.2"
  }
}
